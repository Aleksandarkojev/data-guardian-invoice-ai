# Copy this file to .env and fill in your values. Never commit .env.

# Which model provider to use: openai or anthropic
LLM_PROVIDER=openai

OPENAI_API_KEY=
# Pick a current, small and cheap model from your provider's model list
OPENAI_MODEL=gpt-4o-mini
# To use a local model (data stays on your computer), run Ollama and set:
# OPENAI_BASE_URL=http://localhost:11434/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=invoice_ai
